{
  "rewrites": [
    {
      "source": "/k/:kod",
      "destination": "/k.html"
    },
    {
      "source": "/d/:kod",
      "destination": "/d.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}